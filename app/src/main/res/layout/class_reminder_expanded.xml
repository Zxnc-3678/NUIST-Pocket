<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/class_notification_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textColor="@color/class_notification_text_primary"
        android:textSize="14sp" />
    <TextView android:id="@+id/class_notification_detail"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
        android:textColor="@color/class_notification_text_secondary"
        android:textSize="12sp" />
    <TextView android:id="@+id/class_notification_note"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
        android:textColor="@color/class_notification_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
