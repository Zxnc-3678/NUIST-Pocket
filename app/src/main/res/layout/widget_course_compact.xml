<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_course_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/widget_content_gap" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingVertical="6dp"
    android:background="@drawable/widget_course_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_stripe" android:layout_width="3dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:background="#3155C6" />
        <TextView android:id="@+id/widget_start" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#3155C6" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/widget_end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:textColor="#68758E" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#182641" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#68758E" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#3155C6" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <TextView android:id="@+id/widget_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#68758E" android:textSize="11sp" android:maxLines="1" android:visibility="gone" />
</LinearLayout>
